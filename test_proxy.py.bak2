import requests
import sys

# Cấu hình thông tin Proxy Render thực tế của bạn
PROXY_HOST = "render-proxy-ip.onrender.com"
PROXY_PORT = 443  # Cổng HTTPS SSL mặc định của Render
PROXY_USER = "ksmart"
PROXY_PASS = "RenderProxy2026!"

def test_proxy():
    proxy_url = f"http://{PROXY_USER}:{PROXY_PASS}@{PROXY_HOST}:{PROXY_PORT}"
    proxies = {
        "http": proxy_url,
        "https": proxy_url
    }

    print(f"📡 Đang kiểm tra kết nối qua Render Proxy: {PROXY_HOST}...")
    try:
        # 1. Lấy IP gốc trước
        my_ip = requests.get("https://api.ipify.org?format=json", timeout=10).json()["ip"]
        print(f"🏠 IP gốc hiện tại của máy bạn: {my_ip}")

        # 2. Lấy IP qua Proxy Render
        res = requests.get("https://api.ipify.org?format=json", proxies=proxies, timeout=15)
        proxy_ip = res.json()["ip"]
        print(f"🚀 IP Mới qua Render Proxy: {proxy_ip}")

        # 3. Tra cứu vị trí địa lý của IP Render
        geo = requests.get(f"https://ipapi.co/{proxy_ip}/json/", proxies=proxies, timeout=15).json()
        print(f"🌍 Vị trí IP: {geo.get('city')}, {geo.get('country_name')} (ISP: {geo.get('org')})")
        print("✅ Proxy hoạt động hoàn hảo 100%!")
    except Exception as e:
        print(f"❌ Lỗi kết nối proxy (có thể container đang build, vui lòng đợi 1-2 phút): {e}")

if __name__ == "__main__":
    test_proxy()
